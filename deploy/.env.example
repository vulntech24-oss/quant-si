# Copy to deploy/.env and fill in on the server. Never commit deploy/.env.
# Names only here; values are yours.
QD_POSTGRES_PASSWORD=
QD_DOMAIN=
# Optional backups (ADR 0015):
# passphrase that encrypts dumps and the master-key copy (keep it apart from the server)
QD_BACKUP_PASSPHRASE=
# rclone remote for off-site copies, e.g. b2:quantdesk-backups (configure with `rclone config`)
QD_BACKUP_REMOTE=
# optional separate remote for the master key
QD_BACKUP_KEY_REMOTE=
QD_BACKUP_KEEP_DAYS=90
